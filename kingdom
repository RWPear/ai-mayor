#!/usr/bin/env bash
# Shortcut: ./kingdom <command> ...  ==  .venv/bin/python -m city.run <command> ...
# Settings like OLLAMA_URL can live in a .env file next to this script (one NAME=value per line).
cd "$(dirname "$0")"
if [ -f .env ]; then set -a; . ./.env; set +a; fi
exec .venv/bin/python -m city.run "$@"
