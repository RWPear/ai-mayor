# Copy to .env (next to ./kingdom) and fill in what you need. .env is never committed.

# Where Ollama is (found automatically if left out)
# OLLAMA_URL=http://192.168.1.23:11434
# OLLAMA_MODEL=qwen3:14b

# Optional: a hosted model for the comments (reading them and writing the replies). Aldric's own thinking stays
# local. Leave these out to keep everything on Ollama.
# COMMENT_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=
# (or any OpenAI-compatible API)
# COMMENT_MODEL=gpt-...
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# COMMENT_MAX_CALLS=1500
